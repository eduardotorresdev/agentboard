#!/bin/bash
# The only way to run tests here. Three layers keep the user's data out of reach:
#   1. AGENTBOARD_HOME is a fresh temp folder and AGENTBOARD_TEST=1 (the app aborts otherwise);
#   2. the tests run inside a system sandbox that denies writes to the real data folders;
#   3. the real folders and preferences are fingerprinted before and after; any change fails.
# Usage: scripts/test-safe [--no-home] [swift-testing args, e.g. --filter X --no-parallel]
#        scripts/test-safe --fingerprint-only   (prints the real data's fingerprint and exits)
#   --no-home: leave AGENTBOARD_HOME unset (only to prove the app aborts; the sandbox still holds).
# The keychain isn't covered by the sandbox: an isolated home uses in-memory credentials, and the
# count of agent login items is part of the fingerprint.
set -uo pipefail
# One run at a time on this machine: parallel suites starve each other's timing tests.
[ -n "${TEST_SAFE_LOCKED:-}" ] || TEST_SAFE_LOCKED=1 exec /usr/bin/lockf "${TMPDIR:-/tmp}/agentboard-test-safe.lock" "$0" "$@"
cd "$(dirname "$0")/.."

SUPPORT="$HOME/Library/Application Support"
WORK="$(mktemp -d "${TMPDIR:-/tmp}/agentboard-test.XXXXXX")"
SCRATCH="${AGENTBOARD_TEST_BUILD:-.build/test-safe}"

fingerprint() {
    # Skipped: the core's log and socket, and the agents' own config folders, which the installed
    # app's agents keep syncing.
    for d in AgentBoard "AgentBoard Dev"; do
        (cd "$SUPPORT/$d" 2>/dev/null && find . -type f ! -name core.log ! -name 'core.sock*' ! -path './organizations/*/claude/*' -exec shasum {} + | sort -k2)
    done
    # The installed app keeps writing its own preferences while in use (cameras, selection), so
    # only entries naming a temporary folder count: those can only come from a run like this one.
    for domain in AgentBoard "AgentBoard Dev" dev.agentboard.AgentBoard swiftpm-testing-helper; do
        defaults read "$domain" 2>/dev/null | grep -E "/private/tmp|/var/folders|/tmp/" | sed "s|^|$domain: |"
    done
    security dump-keychain 2>/dev/null | grep -c "Claude Code-credentials"
    # Playwright's browsers: an installer run against them once added a link and pruned a build.
    (cd "$HOME/Library/Caches/ms-playwright" 2>/dev/null && find . -type f -print0 | sort -z | xargs -0 stat -f "%N %z %m" | shasum)
}

NO_HOME=false
if [ "${1:-}" = "--no-home" ]; then NO_HOME=true; shift; fi


DEV=/Applications/Xcode.app/Contents/Developer
HELPER="$DEV/Toolchains/XcodeDefault.xctoolchain/usr/libexec/swift/pm/swiftpm-testing-helper"
BUNDLE="$PWD/$SCRATCH/arm64-apple-macosx/debug/AgentBoardPackageTests.xctest/Contents/MacOS/AgentBoardPackageTests"
POLICY="(version 1)(allow default)(deny file-write* (subpath \"$SUPPORT/AgentBoard\") (subpath \"$SUPPORT/AgentBoard Dev\"))"

# What the installed app (/Applications) keeps rewriting while the user works, left out of the
# comparison only while it runs (checked at the start and at the end): its board state (database,
# who made what, drafts, layout, images, attachments, browsers, simulators). This run can't
# write them anyway (the sandbox above). Everything else still counts: the account, keys, vault,
# hosts, organizations, and any new file.
# shortcut: a fixed list of the app's own files; extend it when the app starts rewriting another
# while in use (a false alarm names it).
# Pictures agents put on other hosts' boards come down into hosts/<host>/images/ the same way.
installed_app_running() {
    # TEST_SAFE_APP_RUNNING (1 or 0) stands in for the check in --self-test only: it never stops
    # or looks at the user's app.
    if [ -n "${TEST_SAFE_APP_RUNNING:-}" ]; then [ "$TEST_SAFE_APP_RUNNING" = 1 ]; return; fi
    pgrep -qf "^/Applications/AgentBoard.app/"
}
installed_app_files() {
    installed_app_running || return 0
    printf '%s\n' ./agentboard.sqlite ./agentboard.sqlite-wal ./agentboard.sqlite-shm ./makers.json ./composer-drafts.json \
        ./workspace.json ./tools.port ./images/ ./hosts/*/images/ ./attachments/ ./Browsers/ ./Simulators/
}
# An entry ending in / is a folder: everything under it. `*` stands for one path component.
installed_app_files_only() { awk 'FILENAME == ARGV[1] { owned[$0]; next }
    { path = $0; sub(/^[0-9a-f]+  /, "", path)
      for (o in owned) {
          if (path == o) next
          if (o ~ /\/$/) { pattern = o; gsub(/[.]/, "[.]", pattern); gsub(/[*]/, "[^/]+", pattern); if (path ~ ("^" pattern)) next }
      }
      print }' "$WORK/installed" "$1"; }

# --self-test: the filter above on throwaway folders, with the app's check stood in for.
if [ "${1:-}" = "--self-test" ]; then
    FAKE="$WORK/fake"; mkdir -p "$FAKE/hosts/X/images" "$FAKE/images"
    listing() { (cd "$FAKE" && find . -type f -exec shasum {} + | sort -k2); }
    listing > "$WORK/before"
    echo picture > "$FAKE/hosts/X/images/new.png"
    echo picture > "$FAKE/images/new.png"
    echo secret > "$FAKE/hosts/X/host.json"
    listing > "$WORK/after"
    failed=0
    check() {  # $1: running, $2: the paths that must be flagged
        TEST_SAFE_APP_RUNNING=$1 installed_app_files > "$WORK/installed"
        flagged=$(diff <(installed_app_files_only "$WORK/before") <(installed_app_files_only "$WORK/after") | sed -n 's/^> [0-9a-f]*  //p' | sort | tr '\n' ' ')
        if [ "$flagged" = "$2" ]; then echo "self-test: running=$1 flags: $flagged"; else echo "self-test FAILED: running=$1 flags '$flagged', expected '$2'"; failed=1; fi
    }
    check 1 "./hosts/X/host.json "
    check 0 "./hosts/X/host.json ./hosts/X/images/new.png ./images/new.png "
    rm -rf "$WORK"
    exit $failed
fi

# --fingerprint-only: prints the same fingerprint this script compares (less the running installed
# app's own files) and exits, to check the real data around a run made outside it.
if [ "${1:-}" = "--fingerprint-only" ]; then
    installed_app_files > "$WORK/installed"
    fingerprint > "$WORK/now"
    installed_app_files_only "$WORK/now" | shasum
    rm -rf "$WORK"
    exit 0
fi

# SwiftPM sandboxes its own manifest build and can't nest inside ours: build outside, run inside.
swift build --build-tests --scratch-path "$SCRATCH" 2>&1 | grep -E "error:|Build complete" | sort -u
[ "${PIPESTATUS[0]}" -eq 0 ] || exit 1

installed_app_files > "$WORK/installed"
fingerprint > "$WORK/before"
ENVIRONMENT=(AGENTBOARD_TEST=1 "DYLD_FRAMEWORK_PATH=$DEV/Platforms/MacOSX.platform/Developer/Library/Frameworks:$DEV/Platforms/MacOSX.platform/Developer/Library/PrivateFrameworks"
    "DYLD_LIBRARY_PATH=$DEV/Platforms/MacOSX.platform/Developer/usr/lib")
$NO_HOME || ENVIRONMENT+=("AGENTBOARD_HOME=$WORK/home" "HOME=$WORK/user")
mkdir -p "$WORK/home" "$WORK/user"
# /usr/bin/env sets DYLD_* after the sandbox's exec, which would strip them.
safely() { env -u AGENTBOARD_HOME sandbox-exec -p "$POLICY" /usr/bin/env "${ENVIRONMENT[@]}" "$@"; }
# Serial: WorktreeTitleTests hold the main thread for seconds each (real repositories), which
# starves the suites whose cores answer on the main queue when they run alongside.
safely "$HELPER" --test-bundle-path "$BUNDLE" "$BUNDLE" --testing-library swift-testing --no-parallel "$@"
STATUS=$?
# The few XCTest suites run whole: their filter syntax differs. XCTEST=0 skips them. Named one by
# one: a bare xctest run also reruns every Swift Testing test, unfiltered and in parallel.
SUITES=$(grep -rhoE "class [A-Za-z0-9_]+: XCTestCase" Tests | awk '{print $2}' | tr -d : | sort -u | paste -sd, -)
if [ "${XCTEST:-1}" = 1 ] && [ -n "$SUITES" ]; then
    safely "$DEV/usr/bin/xctest" -XCTest "$SUITES" "${BUNDLE%/Contents/MacOS/*}" 2>&1 | grep -E "error:|failed|Executed .* tests"
    [ "${PIPESTATUS[0]}" -eq 0 ] || STATUS=1
fi
fingerprint > "$WORK/after"
installed_app_files >> "$WORK/installed"

if ! diff -q <(installed_app_files_only "$WORK/before") <(installed_app_files_only "$WORK/after") >/dev/null; then
    echo "test-safe: THE REAL DATA FOLDER OR PREFERENCES CHANGED. Stop and report:" >&2
    diff <(installed_app_files_only "$WORK/before") <(installed_app_files_only "$WORK/after") >&2
    exit 99
fi
echo "test-safe: real data unchanged (exit $STATUS, work folder $WORK)"
exit $STATUS
